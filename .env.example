# ==========================================
# EdumenAI — Phase 01 Environment Template
# ==========================================

# ==========================================
# App Ports (separated to avoid local collisions)
# ==========================================
API_PORT=4000
WEB_PORT=3000

# ==========================================
# Database
# ==========================================
DATABASE_URL=postgresql://user:password@localhost:5432/edumenai

# ==========================================
# Multi-Provider AI Gateway Configuration
# Supported providers: google | openai | anthropic | openrouter
# ==========================================

# Global default provider & model
AI_PROVIDER=google
AI_MODEL=gemini-3.5-flash

# Optional per-task overrides
# AI_VISION_PROVIDER=google
# AI_VISION_MODEL=gemini-3.5-flash
# AI_EVAL_PROVIDER=google
# AI_EVAL_MODEL=gemini-3.5-flash

# Request timeout in milliseconds (default: 120000)
AI_TIMEOUT_MS=120000

# Optional max output tokens
# AI_VISION_MAX_TOKENS=16384
# AI_EVAL_MAX_TOKENS=16384

# ==========================================
# Provider API Keys
# ==========================================
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Provider base URLs (only required for proxies / custom endpoints)
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter metadata
# OPENROUTER_SITE_URL=https://edumenai.example.com
# OPENROUTER_APP_NAME=EdumenAI

# Optional Gemini thinking depth (MINIMAL | LOW | MEDIUM | HIGH)
# GEMINI_VISION_THINKING_LEVEL=LOW
# GEMINI_EVAL_THINKING_LEVEL=MEDIUM

# ==========================================
# Frontend → API Networking
# ==========================================

# Public browser-facing API URL (used by client-side JS)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-side internal API URL used by Next.js rewrites / route handlers
# In Dokploy this is the public https://api.yourdomain.com (or internal service URL if available)
API_INTERNAL_URL=http://localhost:4000

# ==========================================
# Optional / Future
# ==========================================
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_TEACHER_GROUP_ID=
