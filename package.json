{
  "name": "edumenai",
  "version": "1.0.0",
  "description": "EdumenAI — AI-powered marking and learning feedback platform",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "EdumenAI / EDUMENIA",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "scripts": {
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@edumenai/api",
    "build:web": "turbo run build --filter=@edumenai/web",
    "start:api": "pnpm --filter=@edumenai/api start",
    "start:web": "pnpm --filter=@edumenai/web start",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter=@edumenai/api dev",
    "dev:web": "pnpm --filter=@edumenai/web dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:api": "pnpm --filter=@edumenai/api typecheck",
    "typecheck:web": "pnpm --filter=@edumenai/web typecheck",
    "db:generate": "pnpm --filter=@edumenai/api db:generate",
    "db:migrate": "pnpm --filter=@edumenai/api db:migrate",
    "db:migrate:dev": "pnpm --filter=@edumenai/api db:migrate:dev",
    "db:seed": "pnpm --filter=@edumenai/api db:seed",
    "db:studio": "pnpm --filter=@edumenai/api db:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
