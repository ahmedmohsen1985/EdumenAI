PORT=3000

# ==========================================
# Multi-Provider AI Gateway Configuration
# Supported providers: google | openai | anthropic | openrouter
# ==========================================

# Global default provider & model (used unless overridden per specialization below)
AI_PROVIDER=google
AI_MODEL=gemini-3.5-flash

# Optional Specialization 1: Handwriting OCR & Exam Question Extraction (Image / PDF)
# Leave empty to inherit AI_PROVIDER / AI_MODEL
# AI_VISION_PROVIDER=google
# AI_VISION_MODEL=gemini-3-flash-preview

# Optional Specialization 2: Exercise 4 Evaluation & Marking Report
# Leave empty to inherit AI_PROVIDER / AI_MODEL
# AI_EVAL_PROVIDER=anthropic
# AI_EVAL_MODEL=claude-3-7-sonnet-latest

# Optional request timeout in milliseconds (default: 120000)
AI_TIMEOUT_MS=120000

# ==========================================
# Provider API Keys & Default Models
# ==========================================

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# Optional thinking depth for Gemini 3.5+ models via direct Google provider (MINIMAL | LOW | MEDIUM | HIGH)
# GEMINI_VISION_THINKING_LEVEL=LOW
# GEMINI_EVAL_THINKING_LEVEL=MEDIUM

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# OpenRouter (Unified access to OpenAI, Anthropic, Google, Qwen, DeepSeek, etc.)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_PDF_ENGINE=mistral-ocr
# Control reasoning token spend on OpenRouter thinking models (none | minimal | low | medium | high)
# Recommended to save ~70-80% OCR cost without hurting transcription: OPENROUTER_VISION_REASONING=low
# OPENROUTER_VISION_REASONING=low
# OPENROUTER_EVAL_REASONING=medium
# AI_EVAL_MAX_TOKENS=16384
# AI_VISION_MAX_TOKENS=16384
# OPENROUTER_SITE_URL=https://edumenai.the-amaj.com
# OPENROUTER_APP_NAME=EdumenAI Exercise 4

# ==========================================
# Telegram Notifications & Cache
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_TEACHER_GROUP_ID=your_teacher_group_id_here
CACHE_TTL_SECONDS=86400
