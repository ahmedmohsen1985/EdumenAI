{
  "name": "@edumenai/api",
  "version": "1.0.0",
  "description": "EdumenAI API — Express backend with Prisma and multi-provider AI gateway",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "dev": "prisma generate && tsx watch src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.prisma.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "node prisma/run-prisma.mjs migrate deploy",
    "db:migrate:dev": "node prisma/run-prisma.mjs migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "node prisma/run-prisma.mjs studio",
    "lint": "eslint src --ext .ts,.js"
  },
  "dependencies": {
    "@edumenai/shared": "workspace:*",
    "@google/genai": "^2.32.0",
    "@prisma/client": "^6.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.0.0",
    "multer": "^2.5.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.6.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
