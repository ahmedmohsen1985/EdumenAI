{
  "name": "@edumenai/shared",
  "version": "1.0.0",
  "description": "Shared Zod schemas and TypeScript types for EdumenAI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
